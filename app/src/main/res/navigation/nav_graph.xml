<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_view"
    app:startDestination="@id/loginFragment">
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.jcxdc.musium.ui.screen.SplashFragment"
        android:label="fragment_splash"
        tools:layout="@layout/fragment_splash" >
        <action
            android:id="@+id/action_splashFragment_to_signUpFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_splashFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.jcxdc.musium.ui.screen.LoginFragment"
        android:label="fragment_sign_up"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.jcxdc.musium.ui.screen.RegisterFragment"
        android:label="fragment_register"
        tools:layout="@layout/fragment_register" >
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

        <fragment
            android:id="@+id/homeFragment"
            android:name="com.jcxdc.musium.ui.screen.HomeFragment"
            android:label="fragment_home"
            tools:layout="@layout/fragment_home" >
            <action
                android:id="@+id/action_homeFragment_to_topArtistFragment"
                app:destination="@id/topArtistFragment" />
            <action
                android:id="@+id/action_homeFragment_to_topTracksFragment"
                app:destination="@id/topTracksFragment" />
            <action
                android:id="@+id/action_homeFragment_to_playerFragment"
                app:destination="@id/playerFragment" />

        </fragment>

    <fragment
        android:id="@+id/ExploreFragment"
        android:name="com.jcxdc.musium.ui.screen.ExploreFragment"
        android:label="fragment_explore"
        tools:layout="@layout/fragment_explore" />
    <fragment
        android:id="@+id/libraryFragment"
        android:name="com.jcxdc.musium.ui.screen.LibraryFragment"
        android:label="fragment_library"
        tools:layout="@layout/fragment_library" >
        <action
            android:id="@+id/action_libraryFragment_to_playerFragment"
            app:destination="@id/playerFragment" />
    </fragment>
    <fragment
        android:id="@+id/topAlbumFragment"
        android:name="com.jcxdc.musium.ui.screen.TopAlbumFragment"
        android:label="fragment_top_album"
        tools:layout="@layout/fragment_top_album" />
    <fragment
        android:id="@+id/topArtistFragment"
        android:name="com.jcxdc.musium.ui.screen.TopArtistFragment"
        android:label="fragment_top_artist"
        tools:layout="@layout/fragment_top_artist" />
    <fragment
        android:id="@+id/topTracksFragment"
        android:name="com.jcxdc.musium.ui.screen.TopTracksFragment"
        android:label="fragment_top_tracks"
        tools:layout="@layout/fragment_top_tracks" />
    <fragment
        android:id="@+id/playlistFragment"
        android:name="com.jcxdc.musium.ui.screen.PlaylistFragment"
        android:label="fragment_playlist"
        tools:layout="@layout/fragment_playlist" />
    <fragment
        android:id="@+id/playerFragment"
        android:name="com.jcxdc.musium.ui.screen.PlayerFragment"
        android:label="fragment_player"
        tools:layout="@layout/fragment_player" >

        <argument

            android:name="isLocalMusic"
            app:argType="boolean"
            />
        <argument

            android:name="localAudio"
            app:argType="integer" />
        <argument

            android:name="RemoteAudio"
            app:argType="integer" />
    </fragment>

</navigation>