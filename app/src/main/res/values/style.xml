<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Style cho TextInputLayout -->
    <style name="CustomTextInputLayout" >
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/hint_color_selector</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeColor">@color/box_stroke_color</item>
        <item name="boxBackgroundColor">@color/input_background</item>
        <item name="startIconTint">@color/white</item>
    </style>

    <!-- Style cho TextInputEditText -->
    <style name="CustomTextInputEditText" >
        <item name="android:drawableStart">@drawable/user</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:textColorHint">#DBE7E8</item>
    </style>
</resources>
